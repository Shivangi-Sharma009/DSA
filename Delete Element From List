#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>
int N;
int list[100];
void take(int N){
    for(int i=0;i<N;i++){
        scanf("%d ",&list[i]);
    }
}
void delete(int X, int N){
    for(int i=0;i<N;i++){
        if(list[i]==X){
            for(int j=i;j<N-1;j++){
                list[j]=list[j+1];
            }
             N--;
        break;
    }
    }
    for(int i=0;i<N;i++){
        printf("%d ",list[i]);
    }
}

int main() {
    scanf("%d",&N);
    take(N);
    int X;
    scanf("%d",&X);
    delete(X,N);
    return 0;
}
