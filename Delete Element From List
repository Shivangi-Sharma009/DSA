#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>
int N;
int list[1000];
void add(int N){
    for(int i=0;i<N;i++){
        scanf("%d",&list[i]);
    }
}
int found;
void search(int X,int N){
    for(int i=0;i<N;i++){
        if(list[i]==X){
            found=1;
        }
    }
    if(found!=1){
        printf("Not Found");
    }else{
        printf("Found");
    }
}
int main() {
    scanf("%d",&N);
    add(N);
    int X;
    scanf("%d",&X);
    search(X,N);
    return 0;
}
