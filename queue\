int isEmpty(){
    return front = -1;
}
int isFull(){
    return rear==MAX-1;
}
void enqueue(int data){
    if(isfull()){
        printf("\nQueue overflow!!!\n");
        return;
    }
    queue[++rear] = data;
    if(front == -1)
        front = rear;
    printf("\n%d inserted in queue\n",data);
}
