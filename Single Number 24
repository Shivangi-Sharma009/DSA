#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>
int N;
int list[30000];
void add(){
    for(int i=0;i<N;i++){
        scanf("%d",&list[i]);
    }
}
void rem(){
    for(int i=0;i<N;i++){
        int count=0;
        for(int j=0;j<N;j++){
            if(list[j]==list[i]){
                count++;
            }
        }
        if(count==1){
            printf("%d",list[i]);
            break;
        }
    }
}
int main() {
    scanf("%d",&N);
    add();
    rem();
    return 0;
}
