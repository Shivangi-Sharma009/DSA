#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>
int N1,N2;
int stack1[1000],stack2[1000], top1=-1,top2=-1;
void push(int stack[],int *top,int val,int N){
    if(*top==N-1){
        printf("Overflow\n");
    }else{
        stack[++(*top)]=val;
    }
}
void pop(int stack[],int *top){
    if(*top==-1){
        printf("Underflow\n");
    }else{
       printf("%d\n",stack[*top]);
        (*top)--;
    }
}
void peek(int stack[],int *top){
    if(*top==-1){
        printf("Underflow\n");
    }else{
       printf("%d\n",stack[*top]);
    }
}
void display(int stack[],int *top){
    if(*top==-1){
        printf("Empty\n");
    }else{
       for(int i=*top;i>=0;i--){
           printf("%d ",stack[i]);
       }
        printf("\n");
    }
}
int main() {
    scanf("%d %d",&N1,&N2);
    int Q,stack,val;
    scanf("%d",&Q);
    char str[30];
    for(int i=0;i<Q;i++){
        scanf("%s",str);
        if(strcmp(str,"PUSH")==0){
            scanf("%d",&stack);
            scanf("%d",&val);
            if(stack==1){
                push(stack1,&top1,val,N1);
            }else{
                 push(stack2,&top2,val,N2);
            }
        }else if(strcmp(str,"POP")==0){
            scanf("%d",&stack);
                if(stack==1){
                    pop(stack1, &top1);
                }else{
                    pop(stack2, &top2);
                }
        }else if(strcmp(str,"PEEK")==0){
            scanf("%d",&stack);
                if(stack==1){
                    peek(stack1, &top1);
                }else{
                    peek(stack2, &top2);
                }
        }else if(strcmp(str,"DISPLAY")==0){
            scanf("%d",&stack);
                if(stack==1){
                    display(stack1, &top1);
                }else{
                    display(stack2, &top2);
                }
            }
    }
    
    return 0;
}
