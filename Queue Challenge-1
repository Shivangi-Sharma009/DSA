#include<string.h>
#include<ctype.h>
#include<math.h>
#include<stdlib.h>

int MAX, Q;
int queue[100000], front = -1, rear = -1;

int isEmpty(){
    return front == -1;
}

int isFull(){
    return rear == MAX - 1;
}

void enqueue(int data){
    if(isFull()){
        printf("Queue Overflow\n");
        return;
    }
    queue[++rear] = data;
    if(front == -1)
        front = rear;
}

int dequeue(){
    if(isEmpty()){
        printf("Queue Underflow\n");
        return -1;
    }
    int val = queue[front++];
    if(front > rear)
        front = rear = -1;
    return val;
}

int peek(){
    if(isEmpty()){
        printf("Queue Underflow\n");
        return -1;
    }
    return queue[front];
}

void display(){
    if(isEmpty()){
        printf("Queue is Empty\n");
        return;
    }
    for(int i = front; i <= rear; i++){
        printf("%d ", queue[i]);
    }
    printf("\n");
}

int main(){
    scanf("%d", &MAX);
    scanf("%d", &Q);
    int X;
    for(int i = 0; i < Q; i++){
        int choice;
        scanf("%d", &choice);

        switch(choice){
            case 1:
                scanf("%d", &X);
                enqueue(X);
                break;

            case 2:
                {
    int val = dequeue();
    if(val != -1)
        printf("%d\n", val);
    break;
}

case 3:
{
    int val = peek();
    if(val != -1)
        printf("%d\n", val);
    break;
}

            case 4:
                display();
                break;
        }
    }

    return 0;
}
