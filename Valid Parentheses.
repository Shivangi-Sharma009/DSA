#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {
    char str[100];
    fgets(str,sizeof(str),stdin);
    int len=strlen(str),top=-1,flag=0;
    char stack[len];
    for(int i=0;i<len;i++){
        char ch=str[i];
        if(ch=='('||ch=='['||ch=='{'){
            stack[++top]=ch;
        }else if(ch==')'||ch==']'||ch=='}'){
            if(ch==')'&& stack[top]=='('){
                top--;
            }else if(ch==']'&& stack[top]=='['){
                top--;
            }else if(ch=='}'&& stack[top]=='{'){
                top--;
            }else{
                flag=1;
                break;
            }
        }
    }
    if(flag==0&&top==-1){
        printf("%s is Valid",str);
    }else{
        printf("%s is Invalid",str);
    }
    return 0;
}
