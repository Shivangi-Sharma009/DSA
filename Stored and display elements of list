#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>
int N;
int list[100];
void display(int N){
    for(int i=0;i<N;i++){
        scanf("%d",&list[i]);
    }for(int i=0;i<N;i++){
        printf("%d ",list[i]);
    }
}

int main() {
    scanf("%d",&N);
    display(N); 
    return 0;
}
